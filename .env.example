# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Amigo Merch (Docker)
#
# Copia este archivo a ".env" en la raíz del proyecto y llena los valores.
# NUNCA subas el archivo .env real al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (PostgreSQL en contenedor) ──────────────────────────────────
POSTGRES_DB=amigomerch_db
POSTGRES_USER=amigomerch_user
POSTGRES_PASSWORD=cambia_esta_contrasena_por_una_segura

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Genera un valor aleatorio seguro, p.ej.:
#   openssl rand -hex 32
JWT_SECRET=genera_un_valor_aleatorio_aqui
UNSUBSCRIBE_SECRET=genera_un_valor_aleatorio_aqui

# ── URLs ──────────────────────────────────────────────────────────────────────
CLIENT_URL=https://amigomerch.mx

# ── Envia.com — usar credenciales de PRODUCCIÓN ───────────────────────────────
ENVIA_API_URL=https://api.envia.com
ENVIA_API_KEY=

# ── Mercado Pago — usar credenciales de PRODUCCIÓN ───────────────────────────
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# ── SMTP (Gmail) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=amigomerchmx@gmail.com
SMTP_PASS=
SMTP_FROM=AmigoMerch <amigomerchmx@gmail.com>

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Bodega / Dirección de Origen (Envia.com) ──────────────────────────────────
ORIGIN_NAME=Amigo Merch
ORIGIN_COMPANY=Amigo Merch
ORIGIN_EMAIL=amigomerchmx@gmail.com
ORIGIN_PHONE=3312345678
ORIGIN_STREET=Bodega Principal
ORIGIN_NUMBER=1
ORIGIN_DISTRICT=Centro
ORIGIN_CITY=Zapopan
ORIGIN_STATE=JA
ORIGIN_COUNTRY=MX
ORIGIN_POSTAL_CODE=45200
ORIGIN_REFERENCE=
