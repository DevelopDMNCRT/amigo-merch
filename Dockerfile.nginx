# ── Stage 1: Build Client (tienda pública) ────────────────────────────────────
FROM node:20-alpine AS client-builder
WORKDIR /app
COPY client/package*.json ./
RUN npm install
COPY client/ .
RUN npm run build

# ── Stage 2: Build Admin (panel de administración) ────────────────────────────
FROM node:20-alpine AS admin-builder
WORKDIR /app
COPY admin/package*.json ./
RUN npm install
COPY admin/ .
# Usar build-only para omitir type-check en Docker (ya lo valida el CI)
RUN npm run build-only

# ── Stage 3: Nginx sirve los sitios estáticos ─────────────────────────────────
FROM nginx:1.27-alpine
COPY --from=client-builder /app/dist /usr/share/nginx/client
COPY --from=admin-builder  /app/dist /usr/share/nginx/admin
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80 8080
